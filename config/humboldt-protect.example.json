{
  "version": 1,
  "shares": {
    "Biblioteca": {"path": "/srv/SEU_VOLUME/Biblioteca", "protect": true, "backup": true},
    "Ti":         {"path": "/srv/SEU_VOLUME/Ti",         "protect": true, "backup": true},
    "Fileserver": {"path": "/srv/SEU_VOLUME/Fileserver", "protect": true, "backup": true},
    "Imagens":    {"path": "/srv/SEU_VOLUME/Imagens",    "protect": true, "backup": true},
    "Scanner":    {"path": "/srv/SEU_VOLUME/Scanner",    "protect": true, "backup": true},
    "Studio":     {"path": "/srv/SEU_VOLUME/Studio",     "protect": true, "backup": true}
  },
  "server_backup": true,
  "server_paths": [
    "/etc",
    "/usr/local/sbin/humboldt-protect",
    "/usr/local/sbin/humboldt-protect-watch",
    "/usr/local/sbin/humboldt-protect-contain",
    "/usr/local/sbin/humboldt-protect-nft-init",
    "/usr/local/sbin/humboldt-dash-notify",
    "/var/lib/humboldt-protect"
  ],
  "backup_root": "/var/lib/humboldt-protect/server-metadata",
  "borg": {
    "files_repo": "/srv/SEU_BACKUP/borg-files",
    "server_repo": "/srv/SEU_BACKUP/borg-server",
    "passphrase_file": "/etc/humboldt-protect/borg.passphrase",
    "compression": "zstd,6",
    "keep_daily": 7,
    "keep_weekly": 4,
    "keep_monthly": 6
  },
  "scheduler": {
    "files_time": "23:00",
    "server_time": "02:00",
    "catchup_hours": 6,
    "retry_minutes": 15
  },
  "detector": {
    "window_seconds": 5,
    "min_files": 5,
    "min_writes": 3,
    "min_rename_delete": 3,
    "cooldown_seconds": 300
  },
  "containment": {
    "client_network": "192.168.150.0/24",
    "server_ip": "192.168.150.9",
    "block_timeout": "5m"
  }
}
