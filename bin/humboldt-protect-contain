#!/bin/bash
set -u

LOGGER=/usr/bin/logger
HELPER=/usr/local/sbin/humboldt-protect-quarantine

USER_ARG="${1:-}"
IP_ARG="${2:-}"

if [ -z "$USER_ARG" ] || [ -z "$IP_ARG" ]; then
    $LOGGER -p local0.err -t humboldt-protect \
        "CONTENCAO NEGADA parametros-invalidos"
    exit 2
fi

$LOGGER -p local0.crit -t humboldt-protect \
    "CONTENCAO INICIADA user=$USER_ARG ip=$IP_ARG modo=quarentena-permanente"

if "$HELPER" block "$USER_ARG" "$IP_ARG"; then
    $LOGGER -p local0.crit -t humboldt-protect \
        "CONTENCAO APLICADA user=$USER_ARG ip=$IP_ARG modo=quarentena-permanente"
    exit 0
fi

RC=$?

$LOGGER -p local0.err -t humboldt-protect \
    "CONTENCAO FALHOU user=$USER_ARG ip=$IP_ARG rc=$RC"

exit "$RC"
