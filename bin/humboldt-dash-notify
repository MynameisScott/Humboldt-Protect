#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import urllib.request
import urllib.error

ENV_FILE = Path("/etc/humboldt-protect/dash-notify.env")


def load_env():
    if ENV_FILE.exists():
        for raw in ENV_FILE.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            os.environ.setdefault(key.strip(), value.strip())


def main():
    load_env()
    parser = argparse.ArgumentParser(description="Envia notificacao ao Dash Zabbix")
    parser.add_argument("--level", required=True, choices=["gray", "yellow", "red"])
    parser.add_argument("--source", required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument("--details", required=True)
    parser.add_argument("--event-id", required=True)
    args = parser.parse_args()

    url = os.environ.get("DASH_NOTIFICATION_URL")
    token = os.environ.get("DASH_NOTIFICATION_TOKEN")
    if not url or not token:
        raise SystemExit("DASH_NOTIFICATION_URL/TOKEN nao configurados")

    payload = json.dumps({
        "level": args.level,
        "source": args.source,
        "title": args.title,
        "details": args.details,
        "event_id": args.event_id,
    }).encode()

    req = urllib.request.Request(
        url,
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token,
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            print(resp.read().decode())
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        print(body)
        raise SystemExit(exc.code)


if __name__ == "__main__":
    main()
