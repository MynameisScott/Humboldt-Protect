#!/bin/bash
set -eu

NFT=/usr/sbin/nft
HELPER=/usr/local/sbin/humboldt-protect-quarantine

# Migra uma estrutura antiga com timeout para quarentena permanente.
if $NFT list set inet ransomware_guard blocked_ipv4 >/dev/null 2>&1; then
    if $NFT list set inet ransomware_guard blocked_ipv4 \
        | grep -Eq '(^|[[:space:]])timeout([[:space:]]|$)'; then
        $NFT delete table inet ransomware_guard
    fi
fi

if ! $NFT list table inet ransomware_guard >/dev/null 2>&1; then
    $NFT -f - <<'NFT'
table inet ransomware_guard {
    set blocked_ipv4 {
        type ipv4_addr
    }

    chain input {
        type filter hook input priority -10; policy accept;

        ip saddr @blocked_ipv4 tcp dport { 139, 445 } \
            counter drop comment "SMB ransomware permanent quarantine"
    }
}
NFT
fi

# Reaplica bloqueios persistentes apos reboot/reinicio.
if [ -x "$HELPER" ]; then
    "$HELPER" restore
fi
