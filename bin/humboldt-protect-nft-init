#!/bin/bash
set -eu

NFT=/usr/sbin/nft
TABLE=ransomware_guard
SET=blocked_ipv4
CHAIN=input_guard

if ! $NFT list table inet "$TABLE" >/dev/null 2>&1; then
    $NFT add table inet "$TABLE"
fi

if ! $NFT list set inet "$TABLE" "$SET" >/dev/null 2>&1; then
    $NFT add set inet "$TABLE" "$SET" '{ type ipv4_addr; flags timeout; }'
fi

if ! $NFT list chain inet "$TABLE" "$CHAIN" >/dev/null 2>&1; then
    $NFT add chain inet "$TABLE" "$CHAIN" '{ type filter hook input priority -10; policy accept; }'
fi

# Recria somente as regras gerenciadas pelo Humboldt Protect nesta chain.
$NFT flush chain inet "$TABLE" "$CHAIN"
$NFT add rule inet "$TABLE" "$CHAIN" ip saddr @"$SET" tcp dport '{ 139, 445 }' drop
